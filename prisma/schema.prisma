datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ========================================
// ENUMS
// ========================================
enum Role {
  SUPER_ADMIN
  HR_ADMIN
  TEAM_LEADER
  MANAGER
  EMPLOYEE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmployeeStatus {
  ACTIVE
  PROBATION
  NOTICE_PERIOD
  TERMINATED
  RESIGNED
}

// How an employee left; drives notice pay in the final settlement. Values match EmployeeStatus.
enum SeparationType {
  TERMINATED
  RESIGNED
}

enum AttendanceStatus {
  PRESENT
  LATE
  HALF_DAY
  ABSENT
  ON_LEAVE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  GENERATED
  PAID
}

enum AppraisalPeriod {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum AppraisalStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  FINALIZED
}

// ========================================
// AUTH & USERS
// ========================================
model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String
  role             Role              @default(EMPLOYEE)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  employee         Employee?
  appraisalReviews AppraisalReview[] @relation("AppraisalReviewer")
}

// ========================================
// MULTI-COMPANY / SISTER CONCERNS
// ========================================
model Company {
  id          String          @id @default(cuid())
  name        String          // e.g. "TechBites Media", "TechBites Logistics"
  code        String          @unique // e.g. "TBM", "TBL"
  isParent    Boolean         @default(false)
  logoUrl     String?
  address     String?
  binNumber   String?         // Business Identification Number / Tax ID
  phone       String?
  email       String?
  createdAt   DateTime        @default(now())

  employees   Employee[]
  departments Department[]
  payrolls    PayrollRecord[]
}

// ========================================
// CORE HR: ORG STRUCTURE & PROFILES
// ========================================
model Department {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  
  companyId   String?
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)

  employees   Employee[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Designation {
  id          String       @id @default(cuid())
  title       String       @unique
  description String?
  employees   Employee[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Employee {
  id               String          @id @default(cuid())
  employeeCode     String          @unique
  biometricId      String?         @unique // Shared device/biometric machine card ID
  userId           String?         @unique
  user             User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId        String?
  company          Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)

  firstName        String
  lastName         String
  phone            String?
  nationalId       String?
  gender           String?
  dateOfBirth      DateTime?
  address          String?
  bloodGroup       String?         // e.g. "A+", "O-"
  photoUrl         String?         // /api/files/<id> for an uploaded image, or a site-relative path / http(s) URL
  nidScanUrl       String?         // scanned National ID card; same forms as photoUrl
  referenceName    String?
  referencePhone   String?
  referenceRelation String?
  referenceDetails String?         // free text: referee names, relation and contact numbers

  joiningDate      DateTime
  employmentType   EmploymentType  @default(FULL_TIME)
  status           EmployeeStatus  @default(PROBATION)

  departmentId     String?
  department       Department?     @relation(fields: [departmentId], references: [id])
  designationId    String?
  designation      Designation?    @relation(fields: [designationId], references: [id])

  managerId        String?
  manager          Employee?       @relation("TeamHierarchy", fields: [managerId], references: [id])
  subordinates     Employee[]      @relation("TeamHierarchy")

  attendances      AttendanceRecord[]
  leaveRequests    LeaveRequest[]
  salaryStructure  SalaryStructure?
  payrollRecords   PayrollRecord[]
  appraisalReviews AppraisalReview[]
  settlements      FinalSettlement[]
  files            StoredFile[]

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

// Uploaded employee images (photo, NID scan), served only through the access-checked /api/files/[id] route.
// Temporary store in Postgres until object storage (e.g. Vercel Blob) is provisioned; images are resized in the
// browser before upload, so rows stay small.
model StoredFile {
  id          String    @id @default(cuid())
  employeeId  String?
  employee    Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind        String    // "PHOTO" | "NID_SCAN"
  contentType String
  size        Int
  data        Bytes
  createdAt   DateTime  @default(now())

  @@index([employeeId])
}

// ========================================
// SEPARATION & FINAL SETTLEMENT
// ========================================
// Full & final settlement taken when an employee is released (Bangladesh Labour Act 2006).
// Every input and computed line is snapshotted, so a later salary change never rewrites a processed release.
model FinalSettlement {
  id                    String         @id @default(cuid())
  employeeId            String
  employee              Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  separationType        SeparationType
  joiningDate           DateTime       @db.Date
  releaseDate           DateTime       @db.Date
  serviceDays           Int
  payableYears          Int            // years the service benefit was paid for
  serviceBenefitDaysPerYear Int        @default(0) // 30 (Section 26 / 27 10+ yr), 14 (Section 27 5-10 yr) or 0
  basicSalary           Float

  noticePayApplied      Boolean
  serviceBenefitApplied Boolean
  unusedLeaveDays       Float          @default(0)
  unpaidSalaryDays      Float          @default(0)

  noticePay             Float          @default(0)
  serviceBenefit        Float          @default(0)
  leaveEncashment       Float          @default(0)
  unpaidSalary          Float          @default(0)
  deductions            Float          @default(0)
  netPayable            Float

  processedById         String?        // User.id of the HR/admin who confirmed the release
  createdAt             DateTime       @default(now())

  @@index([employeeId])
}

// ========================================
// TIME, ATTENDANCE & SHIFTS
// ========================================
model Shift {
  id           String             @id @default(cuid())
  name         String
  startTime    String
  endTime      String
  graceMinutes Int                @default(15)
  attendances  AttendanceRecord[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model AttendanceRecord {
  id          String           @id @default(cuid())
  employeeId  String
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date        DateTime         @db.Date
  checkIn     DateTime?
  checkOut    DateTime?
  status      AttendanceStatus @default(ABSENT)

  shiftId     String?
  shift       Shift?           @relation(fields: [shiftId], references: [id])

  source      String           @default("WEB")
  ipAddress   String?
  notes       String?

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([employeeId, date])
}

// ========================================
// LEAVE MANAGEMENT
// ========================================
model LeaveType {
  id          String         @id @default(cuid())
  name        String         @unique
  daysAllowed Int            @default(14)
  requests    LeaveRequest[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model LeaveRequest {
  id          String       @id @default(cuid())
  employeeId  String
  employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  leaveTypeId String
  leaveType   LeaveType    @relation(fields: [leaveTypeId], references: [id])

  startDate   DateTime     @db.Date
  endDate     DateTime     @db.Date
  reason      String
  status      LeaveStatus  @default(PENDING)
  approvedBy  String?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// ========================================
// PAYROLL & COMPENSATION
// ========================================
model SalaryStructure {
  id           String    @id @default(cuid())
  employeeId   String    @unique
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  basicSalary  Float
  houseRent    Float     @default(0)
  medicalAllow Float     @default(0)
  otherAllow   Float     @default(0)
  taxDeduction Float     @default(0)
  providentFund Float    @default(0) // monthly PF contribution withheld from pay

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model PayrollRecord {
  id          String        @id @default(cuid())
  employeeId  String
  employee    Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  companyId   String?
  company     Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)

  month       String        // e.g. "September 2026"
  basicSalary Float
  allowances  Float         // total of the allowance lines below
  deductions  Float         // total of the deduction lines below
  netSalary   Float
  status      PayrollStatus @default(DRAFT)
  paymentDate DateTime?

  // Line items snapshotted at generation, so a later salary change never rewrites an issued pay-slip.
  houseRent           Float @default(0)
  medicalAllow        Float @default(0)
  otherAllow          Float @default(0)
  taxDeduction        Float @default(0)
  providentFund       Float @default(0)
  attendanceDeduction Float @default(0) // late / absent fine
  lateDays            Int   @default(0)
  absentDays          Int   @default(0)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([employeeId, month])
  @@index([companyId, month])
}

// ========================================
// PERFORMANCE & APPRAISALS
// ========================================
model AppraisalCycle {
  id        String            @id @default(cuid())
  title     String
  period    AppraisalPeriod   @default(QUARTERLY)
  startDate DateTime
  endDate   DateTime
  isActive  Boolean           @default(true)
  reviews   AppraisalReview[]
  createdAt DateTime          @default(now())
}

model AppraisalReview {
  id              String          @id @default(cuid())
  cycleId         String
  cycle           AppraisalCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewerId      String?
  reviewer        User?           @relation("AppraisalReviewer", fields: [reviewerId], references: [id])
  attendanceScore Float           @default(0.0)
  productivity    Int             @default(3)
  qualityOfWork   Int             @default(3)
  collaboration   Int             @default(3)
  finalScore      Float           @default(0.0)
  feedback        String?
  status          AppraisalStatus @default(DRAFT)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([cycleId, employeeId])
}

// PayPulse integration models. These deliberately use their own namespace and
// do not add relations to the existing HRMS models, so the established HR
// schema and generated client contracts remain unchanged.
enum PayModel {
  HOURLY
  DAILY
  QUANTITY
  MONTHLY
}

model Device {
  id           String   @id @default(cuid())
  company_id   String
  device_sn    String
  name         String?
  location     String?
  last_seen_at DateTime?
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@unique([company_id, device_sn])
  @@index([company_id])
}

model RawAttendanceLog {
  id              String   @id @default(cuid())
  company_id      String
  device_sn       String
  device_user_id  String
  employee_id     String?
  punch_type      String?
  punch_timestamp DateTime
  processed       Boolean  @default(false)

  @@unique([device_sn, device_user_id, punch_timestamp])
  @@index([device_user_id, punch_timestamp])
  @@index([processed])
  @@index([company_id])
}

model DailyAttendanceSummary {
  id                 String   @id @default(cuid())
  employee_id        String
  work_date          DateTime
  first_in           DateTime?
  last_out           DateTime?
  total_logged_hours Float    @default(0)
  overtime_hours     Float    @default(0)
  late_minutes       Int      @default(0)
  attendance_status  String
  produced_units     Int?

  @@unique([employee_id, work_date])
  @@index([employee_id, work_date])
}

model PayrollConfig {
  id         String   @id @default(cuid())
  department String
  pay_model  PayModel
  rules_json String

  @@unique([department, pay_model])
}